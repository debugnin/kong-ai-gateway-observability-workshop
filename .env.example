# Copied to .env by scripts/01-bootstrap-gateway.sh, which appends the Konnect values.
# The Konnect token is NOT stored here: kongctl reads KONGCTL_DEFAULT_KONNECT_PAT or your `kongctl login` session.
DP_IMAGE=kong/kong-ai-gateway:2.3.0
GATEWAY_PORT=18000
GRAFANA_PORT=3000
# Key the mock LLM expects from the gateway (lab-only value).
MOCK_LLM_KEY=mock-llm-key-change-me
# Consumer API keys are generated into .env by scripts/02-apply-config.sh.
